{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "cerenetics": {
    "color": {
      "primitive": {
        "off_white": { "$type": "color", "$value": "#eff2f3" },
        "soft_blue": { "$type": "color", "$value": "#ebecff" },
        "steel_gray": { "$type": "color", "$value": "#a3b4bc" },
        "pale_green": { "$type": "color", "$value": "#d2fbd0" },
        "navy_black": { "$type": "color", "$value": "#0A1128" },
        "pure_white": { "$type": "color", "$value": "#ffffff" }
      },
      "semantic": {
        "background": {
          "primary": { "$type": "color", "$value": "{cerenetics.color.primitive.off_white}" },
          "panel": { "$type": "color", "$value": "{cerenetics.color.primitive.soft_blue}" },
          "glass": { "$type": "color", "$value": "rgba(255, 255, 255, 0.1)" },
          "glass_nav": { "$type": "color", "$value": "rgba(255, 255, 255, 0.72)" },
          "glass_hero": { "$type": "color", "$value": "rgba(255, 255, 255, 0.40)" },
          "cta": { "$type": "color", "$value": "{cerenetics.color.primitive.navy_black}" }
        },
        "text": {
          "primary": { "$type": "color", "$value": "{cerenetics.color.primitive.navy_black}" },
          "secondary": { "$type": "color", "$value": "{cerenetics.color.primitive.steel_gray}" },
          "muted": { "$type": "color", "$value": "#404a52" },
          "decorative": { "$type": "color", "$value": "{cerenetics.color.primitive.steel_gray}" },
          "accent_success": { "$type": "color", "$value": "{cerenetics.color.primitive.pale_green}" },
          "inverse": { "$type": "color", "$value": "{cerenetics.color.primitive.pure_white}" }
        },
        "border": {
          "structural": { "$type": "color", "$value": "{cerenetics.color.primitive.steel_gray}" },
          "glass": { "$type": "color", "$value": "rgba(255, 255, 255, 0.3)" },
          "glass_strong": { "$type": "color", "$value": "rgba(255, 255, 255, 0.6)" }
        },
        "shadow": {
          "nav": { "$type": "shadow", "$value": "0 10px 30px -5px rgba(10, 17, 40, 0.08)" },
          "float": { "$type": "shadow", "$value": "0 12px 36px -4px rgba(10, 17, 40, 0.12)" }
        }
      }
    },
    "typography": {
      "family": {
        "heading": { "$type": "fontFamily", "$value": "Space Grotesk, sans-serif" },
        "body": { "$type": "fontFamily", "$value": "Inter, sans-serif" },
        "accent_italic": { "$type": "fontFamily", "$value": "Fraunces, serif" },
        "pixel": { "$type": "fontFamily", "$value": "VT323, monospace" },
        "data": { "$type": "fontFamily", "$value": "JetBrains Mono, monospace" }
      },
      "size": {
        "micro": { "$type": "dimension", "$value": "12px" },
        "base": { "$type": "dimension", "$value": "16px" },
        "h3": { "$type": "dimension", "$value": "24px" },
        "h2": { "$type": "dimension", "$value": "48px" },
        "h1": { "$type": "dimension", "$value": "72px" }
      },
      "weight": {
        "regular": { "$type": "fontWeight", "$value": "400" },
        "bold": { "$type": "fontWeight", "$value": "700" }
      },
      "letterSpacing": {
        "heading_caps": { "$type": "dimension", "$value": "1.5px" },
        "pixel_micro": { "$type": "dimension", "$value": "0.5px" }
      },
      "leading": {
        "display": { "$type": "dimension", "$value": "0.96" },
        "heading": { "$type": "dimension", "$value": "1.1" },
        "body": { "$type": "dimension", "$value": "1.65" }
      }
    },
    "spacing": {
      "scale": {
        "04": { "$type": "dimension", "$value": "4px" },
        "08": { "$type": "dimension", "$value": "8px" },
        "12": { "$type": "dimension", "$value": "12px" },
        "16": { "$type": "dimension", "$value": "16px" },
        "24": { "$type": "dimension", "$value": "24px" },
        "32": { "$type": "dimension", "$value": "32px" },
        "48": { "$type": "dimension", "$value": "48px" },
        "64": { "$type": "dimension", "$value": "64px" },
        "96": { "$type": "dimension", "$value": "96px" },
        "128": { "$type": "dimension", "$value": "128px" }
      },
      "layout": {
        "container": { "$type": "dimension", "$value": "1440px" },
        "measure_prose": { "$type": "dimension", "$value": "65ch" },
        "split_panel_padding": { "$type": "dimension", "$value": "{cerenetics.spacing.scale.96}" }
      }
    },
    "radius": {
      "none": { "$type": "dimension", "$value": "0px" },
      "sm": { "$type": "dimension", "$value": "4px" },
      "md": { "$type": "dimension", "$value": "8px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "surface": {
      "glassmorphism": {
        "backdrop_blur": { "$type": "dimension", "$value": "16px" }
      }
    },
    "transition": {
      "duration": {
        "fast": { "$type": "duration", "$value": "150ms" },
        "base": { "$type": "duration", "$value": "300ms" }
      },
      "easing": {
        "fluid": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] }
      }
    }
  }
}
